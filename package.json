{
  "name": "writer-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "writer": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "test": "tsc -p tsconfig.json && node --test --test-isolation=none dist/outline.test.js",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.1",
    "commander": "^14.0.1",
    "hono": "^4.9.8",
    "ink": "^6.3.1",
    "ink-text-input": "^6.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22"
  }
}
